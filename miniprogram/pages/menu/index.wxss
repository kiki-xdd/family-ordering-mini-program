.menu-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 128rpx;
  background: #f8fafc;
}

.loading {
  padding-top: 160rpx;
  color: #64748b;
  font-size: 30rpx;
  text-align: center;
}

.menu-shell {
  display: flex;
  height: calc(100vh - 128rpx);
  min-height: 0;
}

.category-list {
  width: 176rpx;
  height: 100%;
  flex-shrink: 0;
  background: #eef2f7;
}

.category-item {
  min-height: 96rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 22rpx 20rpx;
  border-left: 8rpx solid transparent;
  color: #475569;
  font-size: 28rpx;
  line-height: 1.35;
}

.category-item.active {
  border-left-color: #0f766e;
  background: #ffffff;
  color: #0f172a;
  font-weight: 700;
}

.dish-list {
  height: 100%;
  min-width: 0;
  flex: 1;
  background: #ffffff;
}

.empty {
  padding: 96rpx 32rpx;
  color: #94a3b8;
  font-size: 28rpx;
  text-align: center;
}

.dish-row {
  display: flex;
  align-items: center;
  min-height: 184rpx;
  box-sizing: border-box;
  padding: 24rpx 24rpx;
  border-bottom: 1rpx solid #e2e8f0;
}

.dish-image {
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  background: #e2e8f0;
}

.dish-image-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #94a3b8;
  font-size: 24rpx;
}

.dish-main {
  min-width: 0;
  flex: 1;
  padding: 0 20rpx;
}

.dish-name {
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.dish-desc {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.45;
}

.dish-price {
  margin-top: 12rpx;
  color: #dc2626;
  font-size: 28rpx;
  font-weight: 700;
}

.dish-actions {
  width: 148rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-shrink: 0;
}

.quantity-button {
  width: 48rpx;
  height: 48rpx;
  min-height: 48rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  font-size: 34rpx;
  line-height: 48rpx;
}

.quantity-button::after {
  border: 0;
}

.quantity-button.minus {
  border: 1rpx solid #cbd5e1;
  background: #ffffff;
  color: #475569;
}

.quantity-button.plus {
  background: #0f766e;
  color: #ffffff;
}

.quantity {
  width: 44rpx;
  color: #0f172a;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
}

.cart-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  height: 128rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -12rpx 32rpx rgba(15, 23, 42, 0.08);
}

.cart-summary {
  display: flex;
  align-items: center;
}

.cart-count {
  min-width: 48rpx;
  height: 48rpx;
  box-sizing: border-box;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 48rpx;
  text-align: center;
}

.cart-text {
  margin-left: 16rpx;
  color: #475569;
  font-size: 28rpx;
}

.submit-button {
  width: 224rpx;
  height: 72rpx;
  min-height: 72rpx;
  margin: 0;
  border-radius: 36rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 72rpx;
}

.submit-button::after {
  border: 0;
}

.submit-button.disabled {
  background: #cbd5e1;
  color: #ffffff;
}
